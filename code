export default function ThreadlineApp() {
  useFonts();
  const [tab, setTab] = useState("capture");
  const [decisions, setDecisions] = useState([]);
  const [loaded, setLoaded] = useState(false);
  const [extracting, setExtracting] = useState(false);
  const [captureError, setCaptureError] = useState(null);
  const [lastAdded, setLastAdded] = useState(null);

  useEffect(() => {
    (async () => {
      try {
        const res = await window.storage.get(STORAGE_KEY, true);
        if (res && res.value) setDecisions(JSON.parse(res.value));
      } catch (e) {
        // no existing data yet
      } finally {
        setLoaded(true);
      }
    })();
  }, []);

  const persist = useCallback(async (next) => {
    setDecisions(next);
    try {
      await window.storage.set(STORAGE_KEY, JSON.stringify(next), true);
    } catch (e) {
      console.error("Storage error", e);
    }
  }, []);

  const handleExtract = useCallback(
    async (text) => {
      setExtracting(true);
      setCaptureError(null);
      setLastAdded(null);
      try {
        const system =
          "You extract concrete decisions from meeting notes, transcripts, or chat threads. Return ONLY a raw JSON array, no markdown fences, no preamble. Each item: {\"title\": short imperative summary under 12 words, \"owner\": person or team name stated or clearly implied, else \"Unassigned\", \"deadline\": ISO date YYYY-MM-DD if a date is stated or unambiguously inferable, else null, \"reasoning\": one to two sentences on why, in your own words, not quoted}. Only include things the group actually decided or agreed to — not open questions, not action items with no decision behind them. Return [] if nothing qualifies.";
        const items = await callClaude(system, text, { json: true });
        const now = new Date().toISOString();
        const withIds = (Array.isArray(items) ? items : []).map((it) => ({
          id: uid(),
          title: it.title || "Untitled decision",
          owner: it.owner || "Unassigned",
          deadline: it.deadline || null,
          reasoning: it.reasoning || "",
          resolved: false,
          createdAt: now,
        }));
        await persist([...decisions, ...withIds]);
        setLastAdded(withIds.length);
        if (withIds.length > 0) setTab("track");
      } catch (e) {
        setCaptureError("Couldn't extract decisions from that text. Try again.");
      } finally {
        setExtracting(false);
      }
    },
    [decisions, persist]
  );

  const toggleResolved = useCallback(
    (id) => {
      const next = decisions.map((d) => (d.id === id ? { ...d, resolved: !d.resolved } : d));
      persist(next);
    },
    [decisions, persist]
  );

  const tabs = [
    { id: "capture", n: "01", text: "Capture" },
    { id: "track", n: "02", text: "Track" },
    { id: "recall", n: "03", text: "Recall" },
  ];

  return (
    <div className="tl-root">
      <style>{CSS}</style>
      <aside className="tl-side">
        <div className="tl-brand">
          <Spool />
          <span className="tl-brand-name">Threadline</span>
        </div>
        <nav className="tl-nav">
          {tabs.map((t) => (
            <TabButton key={t.id} id={t.id} label={t} active={tab === t.id} onClick={setTab} />
          ))}
        </nav>
        <div className="tl-side-foot">
          <span>{decisions.length} tracked</span>
          <span className="dot-sep">·</span>
          <span>{decisions.filter((d) => statusOf(d) === "overdue").length} overdue</span>
        </div>
      </aside>
      <main className="tl-main">
        {!loaded ? (
          <div className="empty-state" style={{ marginTop: 80 }}>
            <p>Loading the thread…</p>
          </div>
        ) : tab === "capture" ? (
          <CaptureView
            onExtract={handleExtract}
            extracting={extracting}
            error={captureError}
            lastAdded={lastAdded}
          />
        ) : tab === "track" ? (
          <TrackView decisions={decisions} onToggleResolved={toggleResolved} />
        ) : (
          <RecallView decisions={decisions} />
        )}
      </main>
    </div>
  );
}

