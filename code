import React, { useState, useEffect, useCallback, useRef } from "react";

// ---------------------------------------------------------------------------
// Threadline — decisions, tracked.
// A single-file React app: capture decisions from raw meeting text, track
// them on a literal "thread" timeline, and recall the reasoning behind any
// past call in plain language.
// ---------------------------------------------------------------------------

const FONT_LINK_ID = "threadline-fonts";

function useFonts() {
  useEffect(() => {
    if (document.getElementById(FONT_LINK_ID)) return;
    const link = document.createElement("link");
    link.id = FONT_LINK_ID;
    link.rel = "stylesheet";
    link.href =
      "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap";
    document.head.appendChild(link);
  }, []);
}

const STORAGE_KEY = "threadline:decisions";
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
const todayISO = () => new Date().toISOString().slice(0, 10);

function statusOf(d) {
  if (d.resolved) return "resolved";
  if (d.deadline && d.deadline < todayISO()) return "overdue";
  return "pending";
}

const STATUS_META = {
  pending: { label: "Pending", color: "var(--pending)" },
  overdue: { label: "Overdue", color: "var(--overdue)" },
  resolved: { label: "Resolved", color: "var(--resolved)" },
};

async function callClaude(system, userText, { json = false } = {}) {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system,
      messages: [{ role: "user", content: userText }],
    }),
  });
  if (!res.ok) throw new Error(`API error ${res.status}`);
  const data = await res.json();
  const text = (data.content || [])
    .map((b) => (b.type === "text" ? b.text : ""))
    .filter(Boolean)
    .join("\n")
    .trim();
  if (json) {
    const cleaned = text.replace(/^```json\s*/i, "").replace(/```$/i, "").trim();
    return JSON.parse(cleaned);
  }
  return text;
}

