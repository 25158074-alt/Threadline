function CaptureView({ onExtract, extracting, error, lastAdded }) {
  const [text, setText] = useState("");
  return (
    <div className="view capture-view">
      <header className="view-head">
        <h1>Capture</h1>
        <p>Paste meeting notes, a transcript, or a chat thread. Threadline pulls out what was actually decided.</p>
      </header>
      <textarea
        className="capture-box"
        placeholder={`e.g. "We agreed to delay the Q3 launch to October 14th because QA found blocking bugs. Priya owns the revised timeline."`}
        value={text}
        onChange={(e) => setText(e.target.value)}
        rows={12}
      />
      <div className="capture-actions">
        <button
          className="btn-primary"
          disabled={!text.trim() || extracting}
          onClick={() => onExtract(text)}
        >
          {extracting ? "Reading the thread…" : "Extract decisions"}
        </button>
        {text.trim() && !extracting && (
          <button className="btn-ghost" onClick={() => setText("")}>Clear</button>
        )}
      </div>
      {error && <p className="error-line">{error}</p>}
      {lastAdded != null && !error && !extracting && (
        <p className="success-line">
          {lastAdded === 0
            ? "No concrete decisions found in that text — only open questions or actions without a call made."
            : `Added ${lastAdded} decision${lastAdded === 1 ? "" : "s"} to the thread.`}
        </p>
      )}
    </div>
  );
}

function DecisionCard({ d, onToggleResolved }) {
  const status = statusOf(d);
  const meta = STATUS_META[status];
  return (
    <div className="d-card" style={{ "--card-color": meta.color }}>
      <div className="d-stitch" />
      <div className="d-body">
        <div className="d-top">
          <span className="d-status">{meta.label}</span>
          {d.deadline && <span className="d-deadline">{d.deadline}</span>}
        </div>
        <h3 className="d-title">{d.title}</h3>
        <p className="d-reasoning">{d.reasoning}</p>
        <div className="d-foot">
          <span className="d-owner">{d.owner || "Unassigned"}</span>
          <button className="d-resolve" onClick={() => onToggleResolved(d.id)}>
            {d.resolved ? "Reopen" : "Mark resolved"}
          </button>
        </div>
      </div>
    </div>
  );
}

function TrackView({ decisions, onToggleResolved }) {
  const [filter, setFilter] = useState("all");
  const sorted = [...decisions].sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || ""));
  const visible = filter === "all" ? sorted : sorted.filter((d) => statusOf(d) === filter);
  const counts = { pending: 0, overdue: 0, resolved: 0 };
  decisions.forEach((d) => counts[statusOf(d)]++);

  return (
    <div className="view track-view">
      <header className="view-head">
        <h1>Track</h1>
        <p>Every decision on the thread, in the order it was made.</p>
      </header>
      <div className="filter-row">
        {["all", "pending", "overdue", "resolved"].map((f) => (
          <button
            key={f}
            className={`filter-chip ${filter === f ? "is-active" : ""}`}
            onClick={() => setFilter(f)}
            style={f !== "all" ? { "--chip-color": STATUS_META[f].color } : undefined}
          >
            {f === "all" ? `All (${decisions.length})` : `${STATUS_META[f].label} (${counts[f]})`}
          </button>
        ))}
      </div>

      {decisions.length === 0 ? (
        <div className="empty-state">
          <p>Nothing on the thread yet.</p>
          <p className="empty-sub">Capture a meeting to start tracking decisions.</p>
        </div>
      ) : (
        <div className="thread-rail">
          <div className="thread-line" aria-hidden="true" />
          {visible.map((d) => (
            <DecisionCard key={d.id} d={d} onToggleResolved={onToggleResolved} />
          ))}
        </div>
      )}
    </div>
  );
}

function RecallView({ decisions }) {
  const [query, setQuery] = useState("");
  const [messages, setMessages] = useState([]); // {role, text}
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState(null);
  const scrollRef = useRef(null);

  useEffect(() => {
    if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
  }, [messages, loading]);

  const ask = useCallback(async () => {
    const q = query.trim();
    if (!q || loading) return;
    setErr(null);
    setMessages((m) => [...m, { role: "user", text: q }]);
    setQuery("");
    setLoading(true);
    try {
      if (decisions.length === 0) {
        setMessages((m) => [
          ...m,
          { role: "assistant", text: "There's nothing tracked on the thread yet, so I can't answer from records. Capture a meeting first." },
        ]);
        return;
      }
      const records = decisions.map((d) => ({
        title: d.title,
        owner: d.owner,
        deadline: d.deadline,
        reasoning: d.reasoning,
        status: statusOf(d),
        decidedOn: d.createdAt,
      }));
      const system =
        "You answer questions about an organization's tracked decisions using ONLY the JSON decision records provided in the user message. Do not use outside knowledge or invent details. If the records don't cover the question, say plainly that there's no tracked decision for that. Name the specific decision title(s) you drew on. Keep the answer under 120 words, plain conversational prose, no markdown headers.";
      const userMsg = `Decision records:\n${JSON.stringify(records, null, 2)}\n\nQuestion: ${q}`;
      const answer = await callClaude(system, userMsg);
      setMessages((m) => [...m, { role: "assistant", text: answer }]);
    } catch (e) {
      setErr("Couldn't reach the model. Try again.");
    } finally {
      setLoading(false);
    }
  }, [query, loading, decisions]);

  return (
    <div className="view recall-view">
      <header className="view-head">
        <h1>Recall</h1>
        <p>Ask why a call was made. Answers come only from what's tracked on the thread.</p>
      </header>
      <div className="recall-log" ref={scrollRef}>
        {messages.length === 0 && (
          <div className="empty-state">
            <p>Try: "Why did we push the launch date?"</p>
            <p className="empty-sub">Or: "Who owns the pricing decision?"</p>
          </div>
        )}
        {messages.map((m, i) => (
          <div key={i} className={`bubble bubble-${m.role}`}>
            {m.text}
          </div>
        ))}
        {loading && <div className="bubble bubble-assistant is-typing">Checking the thread…</div>}
      </div>
      {err && <p className="error-line">{err}</p>}
      <div className="recall-input-row">
        <input
          type="text"
          value={query}
          placeholder="Ask about a decision…"
          onChange={(e) => setQuery(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && ask()}
        />
        <button className="btn-primary" onClick={ask} disabled={!query.trim() || loading}>
          Ask
        </button>
      </div>
    </div>
  );
}

