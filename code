function Spool({ size = 34 }) {
  return (
    <svg width={size} height={size} viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <circle cx="20" cy="20" r="18" stroke="var(--thread)" strokeWidth="2" strokeDasharray="1 5" strokeLinecap="round" />
      <circle cx="20" cy="20" r="10.5" fill="var(--thread)" opacity="0.15" />
      <circle cx="20" cy="20" r="10.5" stroke="var(--thread)" strokeWidth="1.4" />
      <circle cx="20" cy="20" r="3" fill="var(--thread)" />
    </svg>
  );
}

function TabButton({ id, label, active, onClick }) {
  return (
    <button
      className={`tab-btn ${active ? "is-active" : ""}`}
      onClick={() => onClick(id)}
      aria-current={active ? "page" : undefined}
    >
      <span className="tab-num">{label.n}</span>
      <span className="tab-label">{label.text}</span>
    </button>
  );
}

